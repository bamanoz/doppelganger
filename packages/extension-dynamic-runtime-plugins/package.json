{
  "name": "@doppelganger/doppelganger-dynamic-runtime-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./loader": {
      "types": "./src/plugin.ts",
      "import": "./src/plugin.ts"
    }
  },
  "scripts": {
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "check:catalog": "node scripts/generate-catalog.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@doppelganger/doppelganger-protocols": "0.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@types/node": "26.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
