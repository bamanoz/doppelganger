{
  "name": "@doppelganger/doppelganger-omp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "omp": {
    "name": "Doppelganger",
    "description": "Portable Doppelganger runtime integration for OMP",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@doppelganger/doppelganger-host-omp": "0.0.0",
    "@doppelganger/doppelganger-persona": "0.0.0",
    "@doppelganger/doppelganger-persona-authoring": "0.0.0",
    "@doppelganger/doppelganger-protocols": "0.0.0",
    "@doppelganger/doppelganger-runtime-presets": "0.0.0",
    "node-addon-require-builtin": "^0.1.4"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.5 <19"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.0.9",
    "@types/node": "26.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
