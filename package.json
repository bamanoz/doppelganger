{
  "name": "doppelganger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:scripts": "vitest run --root scripts",
    "test": "npm run test:workspaces && npm run test:scripts",
    "check:cordis": "node scripts/check-single-cordis.mjs",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:integrity": "node scripts/check-repository-integrity.mjs && npm run check:catalog --workspace @doppelganger/doppelganger-dynamic-runtime-plugins",
    "check:focused-specs": "node scripts/check-focused-specs.mjs",
    "check:focused-specs:change": "node scripts/check-focused-specs.mjs --change",
    "test:focused-specs": "node scripts/run-focused-specs.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check": "npm run typecheck && npm run test && npm run check:cordis && npm run check:boundaries && npm run check:integrity"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.0-rc.8",
    "@types/node": "26.4.0",
    "node-addon-require-builtin": "^0.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
